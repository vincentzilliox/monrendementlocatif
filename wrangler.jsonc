{
  // Site 100 % statique : aucun script d'entrée, Cloudflare sert directement
  // le contenu de site/. Le dossier est produit par `python3 build.py`.
  "name": "monrendementlocatif",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./site/",
    // Toute URL inconnue renvoie site/404.html, une vraie page 404 : rien ne
    // rejoue index.html, donc aucune URL fantôme ne peut être indexée.
    "not_found_handling": "404-page"
  }
}
